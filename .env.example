# Copy this file to .env before running the API locally.

PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mybasics_expenses

# Outbound email (SMTP). Defaults target the Mailtrap sandbox, a hosted SMTP
# that captures messages in a web inbox instead of delivering them — great for
# local dev. Fill USERNAME/PASSWORD with your Mailtrap inbox credentials
# (Mailtrap → Inbox → SMTP Settings). Leave SMTP_USERNAME empty to disable
# sending. These values are also read by docker-compose to configure the api
# container.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MyBasics-Expenses <no-reply@mybasics.local>
